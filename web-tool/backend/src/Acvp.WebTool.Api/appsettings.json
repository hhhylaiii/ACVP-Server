{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnvironmentConfig": null,
  "OrleansConfig": {
    "OrleansNodeConfig": [
      {
        "HostName": "localhost",
        "MaxConcurrentWork": 3
      }
    ],
    "OrleansSiloPort": 8000,
    "OrleansGatewayPort": 30000,
    "ClusterId": "cryptoDist-local",
    "MinimumLogLevel": "Warning",
    "OrleansDashboardPort": 8081,
    "FallBackMinimumCores": 3,
    "LoadSheddingCpuThreshold": 0,
    "MaxWorkItemsToQueuePerGenValInstance": 100,
    "TimeoutRetryAttempts": 15
  },
  "WebTool": {
    "Engine": {
      "UseSampleVectors": true
    },
    "Limits": {
      "MaxUploadBytes": 52428800,
      "MaxConcurrentJobs": 2
    },
    "Storage": {
      "ArtifactRoot": "artifacts"
    },
    "Swagger": {
      "Enabled": false
    }
  }
}
